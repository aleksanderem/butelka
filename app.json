{
  "expo": {
    "name": "Butelka",
    "slug": "butelka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "butelka",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0712",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.butelka.game"
    },
    "android": {
      "package": "com.butelka.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0712"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0712"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
