{
  "expo": {
    "name": "Butelka",
    "slug": "butelka",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "butelka",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0712",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.butelka.game",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.butelka.game",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0712"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0712"
        }
      ],
      "expo-font",
      "expo-video",
      "expo-iap",
      "./plugins/withStoreKitConfig"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "59ab5ee8-a364-4d83-ad2c-470d202557a0"
      }
    },
    "owner": "amiesak"
  }
}
